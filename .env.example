# Telegram Bot — заявки с формы обратной связи
# 1. Создайте бота через @BotFather и скопируйте токен
# 2. Напишите боту любое сообщение
# 3. Откройте: https://api.telegram.org/bot<ВАШ_ТОКЕН>/getUpdates
# 4. Найдите "chat":{"id": ...} — это TELEGRAM_CHAT_ID

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Публичный URL сайта (sitemap, robots, Open Graph). На Netlify можно не задавать — используется URL.
# NEXT_PUBLIC_SITE_URL=https://ваш-домен.by

# Netlify (обязательно для формы на продакшене):
# 1. Site configuration → Environment variables
# 2. Добавьте TELEGRAM_BOT_TOKEN и TELEGRAM_CHAT_ID (как в .env.local)
# 3. Scope: All (или Builds + Functions + Runtime)
# 4. Deploys → Trigger deploy → Clear cache and deploy site
